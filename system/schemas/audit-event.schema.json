{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.aikb/schemas/audit-event.schema.json",
  "title": "AIKB audit event schema v1",
  "type": "object",
  "required": ["schema_version", "record_type", "event_id", "timestamp", "source", "agent", "operation", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {
      "enum": ["invocation_started", "invocation_finished", "connection_initialized", "wrapper_failure"]
    },
    "event_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "invocation_id": {"type": ["string", "null"], "maxLength": 120},
    "timestamp": {"type": "string", "format": "date-time"},
    "source": {"enum": ["mcp", "hook"]},
    "agent": {"type": "string", "minLength": 1, "maxLength": 120},
    "client": {"type": ["object", "null"]},
    "connection_id": {"type": ["string", "null"], "maxLength": 120},
    "session_id": {"type": ["string", "null"], "maxLength": 160},
    "project_id": {"type": ["string", "null"], "maxLength": 120},
    "operation": {"type": "string", "minLength": 1, "maxLength": 120},
    "action": {"type": ["object", "null"]},
    "status": {"enum": ["started", "succeeded", "failed", "noop", "blocked"]},
    "outcome_code": {"type": ["string", "null"], "maxLength": 120},
    "result_summary": {"type": ["object", "null"]},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0},
    "error_type": {"type": ["string", "null"], "maxLength": 120}
  },
  "additionalProperties": false
}
