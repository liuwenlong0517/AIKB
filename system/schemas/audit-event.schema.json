{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.aikb/schemas/audit-event.schema.json",
  "title": "AIKB audit event schema v4",
  "type": "object",
  "required": ["schema_version", "record_type", "event_id", "timestamp", "source", "agent", "operation", "status"],
  "properties": {
    "schema_version": {"enum": [1, 2, 3, 4]},
    "record_type": {
      "enum": ["invocation_started", "invocation_finished", "connection_initialized", "wrapper_failure"]
    },
    "event_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "invocation_id": {"type": ["string", "null"], "maxLength": 120},
    "timestamp": {"type": "string", "format": "date-time"},
    "source": {"enum": ["mcp", "hook", "web"]},
    "agent": {"type": "string", "minLength": 1, "maxLength": 120},
    "client": {"type": ["object", "null"]},
    "connection_id": {"type": ["string", "null"], "maxLength": 120},
    "session_id": {"type": ["string", "null"], "maxLength": 160},
    "session_label": {"type": ["string", "null"], "maxLength": 240},
    "project_id": {"type": ["string", "null"], "maxLength": 120},
    "operation": {"type": "string", "minLength": 1, "maxLength": 120},
    "action": {"type": ["object", "null"]},
    "action_text": {"type": ["string", "null"], "maxLength": 1200},
    "status": {"enum": ["started", "succeeded", "failed", "noop", "blocked", "cancelled", "timed_out", "interrupted"]},
    "outcome_code": {"type": ["string", "null"], "maxLength": 120},
    "result_summary": {"type": ["object", "null"]},
    "result_text": {"type": ["string", "null"], "maxLength": 1200},
    "capture_level": {"enum": ["safe", "diagnostic", "full-local", null]},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0},
    "error_type": {"type": ["string", "null"], "maxLength": 120},
    "task_id": {"type": ["string", "null"], "maxLength": 120},
    "action_id": {"type": ["string", "null"], "maxLength": 120},
    "target_task_id": {"type": ["string", "null"], "maxLength": 120},
    "change_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "resource_type": {"enum": ["rule", null]},
    "resource_id": {"enum": ["entry", "user", "agent", "contributing", null]},
    "before_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "after_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "rollback_status": {
      "enum": ["not_applicable", "not_started", "pending", "succeeded", "recovery_required", null]
    },
    "maintenance_target_id": {
      "enum": ["environment", "agent.codex", "agent.claude-code", null]
    },
    "before_fingerprint": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "after_fingerprint": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "restart_required": {
      "type": ["boolean", "null"]
    }
  },
  "additionalProperties": false
}
