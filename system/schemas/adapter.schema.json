{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.aikb/schemas/adapter.schema.json",
  "title": "AIKB Agent adapter manifest",
  "type": "object",
  "required": ["id", "displayName", "platforms", "capabilities", "install"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "displayName": {"type": "string"},
    "platforms": {"type": "array", "items": {"enum": ["windows"]}},
    "capabilities": {
      "type": "object",
      "properties": {
        "mcpStdio": {"type": "boolean"},
        "sessionStart": {"type": "boolean"},
        "preCompact": {"type": "boolean"},
        "stop": {"type": "boolean"},
        "sessionEnd": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "install": {"type": "object"}
  },
  "additionalProperties": false
}
