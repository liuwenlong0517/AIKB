{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.aikb/schemas/work-checkpoint.schema.json",
  "title": "AIKB work checkpoint metadata",
  "type": "object",
  "required": ["work_id", "project_id", "status", "agent", "session_id", "role", "updated_at", "checkpoint_id", "project_path"],
  "properties": {
    "work_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "project_id": {"type": "string"},
    "status": {"enum": ["planned", "active", "blocked", "completed", "abandoned", "superseded"]},
    "work_schema_version": {"type": "string", "enum": ["1", "2"]},
    "agent": {"type": "string", "description": "开放的 Agent 标识，不使用封闭枚举"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"},
    "role": {"type": "string"},
    "author_agent": {"type": "string"},
    "author_session_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"},
    "author_role": {"type": "string"},
    "owner_agent": {"type": "string"},
    "owner_session_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"},
    "ownership_mode": {"type": "string", "enum": ["session-bound", "shared", "handed-off", "legacy-unbound"]},
    "ownership_binding": {"type": "string", "enum": ["", "agent+declared-session", "agent+exact-session"]},
    "participants": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["agent", "session_id", "role"],
        "properties": {
          "agent": {"type": "string"},
          "session_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"},
          "role": {"type": "string"},
          "authorized_at": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "updated_at": {"type": "string"},
    "checkpoint_id": {"type": "string"},
    "project_path": {"type": "string"},
    "workspace_dirty": {"type": "boolean"},
    "repositories": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["role", "path", "branch", "revision", "dirty", "signature"],
        "properties": {
          "role": {"type": "string"},
          "path": {"type": "string"},
          "branch": {"type": "string"},
          "revision": {"type": "string"},
          "dirty": {"type": "boolean"},
          "signature": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"work_schema_version": {"const": "2"}}, "required": ["work_schema_version"]},
      "then": {
        "required": [
          "author_agent", "author_session_id", "author_role", "owner_agent", "owner_session_id",
          "ownership_mode", "ownership_binding", "participants"
        ]
      }
    }
  ],
  "additionalProperties": true
}
